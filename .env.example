# Copy to .env and fill in what you have. Everything is optional — with
# nothing set, SafeRemit runs on mock CAMARA data + a deterministic
# rationale (the "cached demo data" fallback the Tooling Guide recommends).
#
# .env is gitignored — never commit real keys.

# --- Nokia Network-as-Code (CAMARA APIs) ---
# From networkascode.nokia.io: API Playground -> any endpoint -> Code
# Snippets shows a cURL with your application key and the gateway host.
# Setting NAC_API_KEY switches all four clients from mock to live calls.
NAC_API_KEY=
NAC_BASE_URL=https://network-as-code.p-eu.apihub.nokia.io
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
# CAMARA_TIMEOUT_SECONDS=10

# --- Google AI Studio / Gemini (rationale rewriting) ---
# Free key from aistudio.google.com. Without it the rationale uses the
# deterministic template (fine for a live demo).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
