# Copy to .env and fill in what you have. Everything is optional — with
# nothing set, SafeRemit runs on mock CAMARA data and a rules-only
# decision (the "cached demo data" fallback the Tooling Guide recommends).
#
# .env is gitignored — never commit real keys.

# --- Nokia Network-as-Code (CAMARA APIs) ---
# From networkascode.nokia.io: API Playground -> any endpoint -> Code
# Snippets shows a cURL with your application key and the gateway host.
# Setting NAC_API_KEY switches the CAMARA clients from mock to live calls.
NAC_API_KEY=
NAC_BASE_URL=https://network-as-code.p-eu.apihub.nokia.io
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
# CAMARA_TIMEOUT_SECONDS=8

# --- Google AI Studio / Gemini (the AI analyst) ---
# Free key from aistudio.google.com — no credit card. Setting it turns on
# the LLM analyst step: on the escalation path, Gemini reasons about the
# signal combination and its verdict is reconciled with the rules score.
# Without a key, the rules engine decides alone.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_SECONDS=12
